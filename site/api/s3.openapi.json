{
  "openapi": "3.1.0",
  "info": {
    "title": "S3Api (browser)",
    "version": "0.4.0",
    "summary": "The browser-side contract of S3Api (site/api/s3-api.js): its five read methods.",
    "description": "This site has no server. The paths below are logical names for the methods of the browser object S3Api, not URLs anything listens on; operationId is the method name and parameters are its arguments in order. Each operation lists in x-aws-actions the IAM actions it needs on real AWS; the union over the operations a UI uses is the least-privilege list aws.c turns into the template's next plan. S3Api only reads: design 01's planCors and applyPlan are not in it (changes stay with plans and Approve, site/plan.js), so they are listed under x-not-in-s3api, not as operations. Cloud Control calls also need the permissions the AWS::S3::Bucket handler lists: those are in x-aws-handler-actions, with their source and the check still to make before a plan uses them (x-aws-handler-check). On the twin (synthetic account 111122223333) no credentials are used."
  },
  "servers": [],
  "x-browser-global": "S3Api",
  "x-design": "docs/architecture/2026-11-23__01-one-transport-two-back-ends.md",
  "paths": {
    "/buckets": {
      "get": {
        "operationId": "listBuckets",
        "summary": "List the account's buckets",
        "x-wire": "Cloud Control ListResources in us-east-1, TypeName AWS::S3::Bucket, MaxResults 100, paged by NextToken (S3Api follows every page)",
        "x-aws-actions": [
          "cloudformation:ListResources"
        ],
        "x-role": "read",
        "responses": {
          "200": {
            "description": "Every bucket name, sorted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AwsError"
          }
        },
        "x-aws-handler-actions": [
          "s3:ListAllMyBuckets"
        ],
        "x-aws-handler-source": "docs/boto3/2026-11-23__02-cloud-control-s3-handlers.md (boto3.aws.a, from the AWS::S3::Bucket resource schema as cfn-lint 1.61.0 ships it)",
        "x-aws-handler-check": "A snapshot of the schema; check recent names (s3:GetBucketAbac, s3:GetBucketDefaultStorageClass, s3:GetBucketMetadataTableConfiguration) against the Service Authorization Reference for S3 before a plan uses them."
      }
    },
    "/buckets/{bucket}": {
      "get": {
        "operationId": "getBucket",
        "summary": "Read one bucket's properties, including its region",
        "x-wire": "Cloud Control GetResource in us-east-1, TypeName AWS::S3::Bucket; region from RegionalDomainName, us-east-1 when there is none",
        "x-aws-actions": [
          "cloudformation:GetResource"
        ],
        "x-role": "read",
        "parameters": [
          {
            "$ref": "#/components/parameters/bucket"
          }
        ],
        "responses": {
          "200": {
            "description": "The bucket",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bucket"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AwsError"
          }
        },
        "x-aws-handler-actions": [
          "s3:GetAccelerateConfiguration",
          "s3:GetAnalyticsConfiguration",
          "s3:GetBucketAbac",
          "s3:GetBucketCORS",
          "s3:GetBucketDefaultStorageClass",
          "s3:GetBucketLogging",
          "s3:GetBucketMetadataTableConfiguration",
          "s3:GetBucketNotification",
          "s3:GetBucketObjectLockConfiguration",
          "s3:GetBucketOwnershipControls",
          "s3:GetBucketPublicAccessBlock",
          "s3:GetBucketTagging",
          "s3:GetBucketVersioning",
          "s3:GetBucketWebsite",
          "s3:GetEncryptionConfiguration",
          "s3:GetIntelligentTieringConfiguration",
          "s3:GetInventoryConfiguration",
          "s3:GetLifecycleConfiguration",
          "s3:GetMetricsConfiguration",
          "s3:GetReplicationConfiguration",
          "s3:ListBucket",
          "s3:ListTagsForResource"
        ],
        "x-aws-handler-source": "docs/boto3/2026-11-23__02-cloud-control-s3-handlers.md (boto3.aws.a, from the AWS::S3::Bucket resource schema as cfn-lint 1.61.0 ships it)",
        "x-aws-handler-check": "A snapshot of the schema; check recent names (s3:GetBucketAbac, s3:GetBucketDefaultStorageClass, s3:GetBucketMetadataTableConfiguration) against the Service Authorization Reference for S3 before a plan uses them.",
        "x-alternatives": [
          {
            "option": "Read region and CORS with S3 GetBucketLocation and GetBucketCors instead of Cloud Control GetResource (2 actions, not 22)",
            "status": "rejected, 23 Nov 2026, architect.aws.a and dev.2.aws.a",
            "why": "Both are S3 calls from the browser, so they need the bucket's CORS rule to allow this site already. For a bucket with no rule, the very case getBucket diagnoses, the browser fails with TypeError: Failed to fetch before S3 answers, which cannot be told apart from a wrong region or a network fault. A fallback to Cloud Control keeps the 22 handler actions in the role, so it saves nothing. getBucketCors serves buckets already reachable."
          }
        ]
      }
    },
    "/buckets/{bucket}/{region}/objects": {
      "get": {
        "operationId": "listObjects",
        "summary": "One page of folders and files under a prefix",
        "x-wire": "S3 ListObjectsV2: GET ?list-type=2&delimiter=&max-keys=&prefix=&continuation-token=; path-style URL for a bucket name with a dot",
        "x-aws-actions": [
          "s3:ListBucket"
        ],
        "x-role": "read",
        "parameters": [
          {
            "$ref": "#/components/parameters/bucket"
          },
          {
            "name": "region",
            "in": "path",
            "required": true,
            "description": "The bucket's region, from getBucket",
            "schema": {
              "type": "string",
              "examples": [
                "eu-west-1"
              ]
            }
          },
          {
            "name": "prefix",
            "in": "query",
            "required": false,
            "description": "opts.prefix",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "delimiter",
            "in": "query",
            "required": false,
            "description": "opts.delimiter; empty string lists flat",
            "schema": {
              "type": "string",
              "default": "/"
            }
          },
          {
            "name": "token",
            "in": "query",
            "required": false,
            "description": "opts.token: the next of the previous page",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "maxKeys",
            "in": "query",
            "required": false,
            "description": "opts.maxKeys",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectPage"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AwsError"
          }
        },
        "x-arguments": "listObjects(bucket, region, { prefix, delimiter, token, maxKeys })"
      }
    },
    "/buckets/{bucket}/{region}/objects/{key}": {
      "get": {
        "operationId": "getObject",
        "summary": "Read an object, whole or a byte range (the zip reader reads by ranges)",
        "x-wire": "S3 GetObject, GET on the key, optional Range header; 206 with Content-Range for a range",
        "x-aws-actions": [
          "s3:GetObject"
        ],
        "x-role": "read",
        "parameters": [
          {
            "$ref": "#/components/parameters/bucket"
          },
          {
            "name": "region",
            "in": "path",
            "required": true,
            "description": "The bucket's region, from getBucket",
            "schema": {
              "type": "string",
              "examples": [
                "eu-west-1"
              ]
            }
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "range",
            "in": "query",
            "required": false,
            "description": "[start, end], inclusive, sent as Range: bytes=start-end",
            "schema": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The whole object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectBody"
                }
              }
            }
          },
          "206": {
            "description": "The asked range; contentRange set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectBody"
                }
              }
            }
          },
          "416": {
            "description": "The range is past the end of the object: rejects with code InvalidRange (as the twin answers since 787735b)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AwsError"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AwsError"
          }
        },
        "x-arguments": "getObject(bucket, region, key, [start, end])"
      }
    },
    "/buckets/{bucket}/{region}/cors": {
      "get": {
        "operationId": "getBucketCors",
        "summary": "Read a bucket's CORS rules straight from S3, for a bucket this page can already reach (for example to re-check after a plan is applied)",
        "x-arguments": "getBucketCors(bucket, region)",
        "x-wire": "S3 GetBucketCors: GET ?cors on the bucket; 404 NoSuchCORSConfiguration reads as null",
        "x-aws-actions": [
          "s3:GetBucketCORS"
        ],
        "x-role": "read",
        "parameters": [
          {
            "$ref": "#/components/parameters/bucket"
          },
          {
            "name": "region",
            "in": "path",
            "required": true,
            "description": "The bucket's region, from getBucket",
            "schema": {
              "type": "string",
              "examples": [
                "eu-west-1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The rules in getBucket's (Cloud Control) shape, or null when the bucket has none",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Cors"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AwsError"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "bucket": {
        "name": "bucket",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 3,
          "maxLength": 63
        }
      }
    },
    "schemas": {
      "Bucket": {
        "type": "object",
        "required": [
          "name",
          "region"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "examples": [
              "eu-west-1"
            ]
          },
          "cors": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Cors"
              },
              {
                "type": "null"
              }
            ],
            "description": "CorsConfiguration as Cloud Control returns it, or null when the bucket has none"
          }
        }
      },
      "ObjectPage": {
        "type": "object",
        "required": [
          "folders",
          "files",
          "next"
        ],
        "properties": {
          "folders": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "CommonPrefixes"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ObjectSummary"
            }
          },
          "next": {
            "type": [
              "string",
              "null"
            ],
            "description": "NextContinuationToken when IsTruncated; null on the last page"
          }
        }
      },
      "ObjectSummary": {
        "type": "object",
        "required": [
          "key",
          "size",
          "modified"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "modified": {
            "type": "string",
            "description": "LastModified as S3 sends it"
          }
        }
      },
      "AwsError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "status"
        ],
        "description": "The promise rejects with an Error whose message is 'Code: Message' (as Platform.awsError makes), with .code and .status; from S3's <Error> XML or Cloud Control's __type and message. A bucket with no CORS rule for this site rejects with the browser's own TypeError: Failed to fetch, passed through unchanged, so the page can offer the CORS plan.",
        "properties": {
          "code": {
            "type": "string",
            "examples": [
              "NoSuchKey",
              "NoSuchBucket",
              "AccessDenied",
              "InvalidRange"
            ]
          },
          "message": {
            "type": "string",
            "examples": [
              "NoSuchKey: The specified key does not exist."
            ]
          },
          "status": {
            "type": "integer"
          }
        }
      },
      "ObjectBody": {
        "type": "object",
        "required": [
          "status",
          "contentType",
          "contentRange",
          "bytes"
        ],
        "properties": {
          "status": {
            "enum": [
              200,
              206
            ]
          },
          "contentType": {
            "type": "string"
          },
          "contentRange": {
            "type": [
              "string",
              "null"
            ]
          },
          "bytes": {
            "description": "Uint8Array of the body"
          }
        }
      },
      "Cors": {
        "type": "object",
        "required": [
          "CorsRules"
        ],
        "description": "CorsConfiguration as Cloud Control names it; GetBucketCors's XML is read into the same shape",
        "properties": {
          "CorsRules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "AllowedOrigins",
                "AllowedMethods"
              ],
              "properties": {
                "Id": {
                  "type": "string"
                },
                "AllowedOrigins": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "AllowedMethods": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "AllowedHeaders": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "ExposedHeaders": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "MaxAge": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "AwsError": {
        "description": "The promise rejects with this (or TypeError: Failed to fetch for a missing CORS rule)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AwsError"
            }
          }
        }
      }
    }
  },
  "x-not-in-s3api": {
    "planCors": "design 01; plans are built by site/plan.js",
    "applyPlan": "design 01; the change role applies a plan only after Approve, outside S3Api"
  }
}
