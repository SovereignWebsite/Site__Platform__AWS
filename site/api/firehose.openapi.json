{
  "openapi": "3.1.0",
  "info": {
    "title": "FirehoseApi (browser)",
    "version": "0.1.0",
    "summary": "The browser-side contract of FirehoseApi (site/api/firehose-api.js).",
    "description": "This site has no server. The paths are logical names for the methods of the browser object FirehoseApi, not URLs anything listens on; operationId is the method name and parameters are its arguments in order. Each operation lists in x-aws-actions the IAM actions it needs on real AWS. Reads only. Lists return one page { items, next }; FirehoseApi.all drains them with a cap. ListDeliveryStreams gives names only, so list items carry a derived ARN (arnDerived) when the account is known."
  },
  "servers": [],
  "x-browser-global": "FirehoseApi",
  "x-design": "docs/architecture/2026-11-23__03-every-service-one-shape.md (work/architect.aws.a)",
  "paths": {
    "/{region}/streams": {
      "get": {
        "operationId": "streams",
        "summary": "One page of the region's delivery stream names",
        "x-arguments": "streams(region, { next, max })",
        "x-wire": "Firehose ListDeliveryStreams (JSON 1.1, Firehose_20150804); next is the last name, sent as ExclusiveStartDeliveryStreamName",
        "x-aws-actions": [
          "firehose:ListDeliveryStreams"
        ],
        "x-role": "read",
        "parameters": [
          {
            "name": "region",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "eu-west-2"
              ]
            }
          },
          {
            "name": "next",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "next"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StreamSummary"
                      }
                    },
                    "next": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Opaque cursor for the next page; null at the end"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AwsError"
          }
        }
      }
    },
    "/{region}/streams/{name}": {
      "get": {
        "operationId": "stream",
        "summary": "One delivery stream: status, destinations, processors",
        "x-arguments": "stream(region, name)",
        "x-wire": "Firehose DescribeDeliveryStream (JSON 1.1)",
        "x-aws-actions": [
          "firehose:DescribeDeliveryStream"
        ],
        "x-role": "read",
        "parameters": [
          {
            "name": "region",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "eu-west-2"
              ]
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The stream",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stream"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AwsError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StreamSummary": {
        "type": "object",
        "required": [
          "name",
          "region",
          "arn",
          "arnDerived"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "arn": {
            "type": [
              "string",
              "null"
            ]
          },
          "arnDerived": {
            "type": "boolean"
          }
        }
      },
      "Stream": {
        "type": "object",
        "required": [
          "name",
          "arn",
          "region",
          "destinations"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "arn": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "created": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "destinations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "s3",
                    "other"
                  ]
                },
                "bucket": {
                  "type": "string"
                },
                "bucketArn": {
                  "type": "string"
                },
                "prefix": {
                  "type": "string"
                },
                "errorPrefix": {
                  "type": "string"
                },
                "roleArn": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "compression": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "bufferSeconds": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "bufferMb": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "processors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "lambdaArn": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "AwsError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "status"
        ],
        "properties": {
          "code": {
            "type": "string",
            "examples": [
              "ResourceNotFoundException",
              "AccessDeniedException"
            ]
          },
          "message": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          }
        }
      }
    },
    "responses": {
      "AwsError": {
        "description": "The promise rejects with an Error ('Code: Message', .code, .status), or the browser's TypeError for a CORS refusal",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AwsError"
            }
          }
        }
      }
    }
  }
}
