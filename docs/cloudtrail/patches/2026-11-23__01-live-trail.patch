diff --git a/test/twin/cloudtrail-live.test.mjs b/test/twin/cloudtrail-live.test.mjs
new file mode 100644
index 0000000..9afe5fe
--- /dev/null
+++ b/test/twin/cloudtrail-live.test.mjs
@@ -0,0 +1,62 @@
+// The twin writes a CloudTrail record for every change it makes, and for every sign-in, into the trail bucket at once:
+// one .json.gz per region and five minutes, under AWSLogs/<account>/CloudTrail/<region>/yyyy/mm/dd/, with the fields a
+// real record has. IAM and STS (global) under us-east-1. Runs in Node 22; no network.
+import { readFileSync } from "node:fs";
+const fail = (m) => { console.error("FAIL", m); process.exit(1); };
+globalThis.window = globalThis;
+globalThis.location = { origin: "http://localhost", search: "" };
+// the twin's CloudFormation reads the page's own template; serve it from the repository
+globalThis.document = { baseURI: "http://localhost/" };
+globalThis.fetch = async (u) => new Response(readFileSync(new URL("../../site/" + new URL(u).pathname.slice(1), import.meta.url), "utf8"));
+new Function(readFileSync(new URL("../../site/twin.js", import.meta.url), "utf8"))();
+const T = globalThis.AwsTwin, A = T.account;
+const read = { authorization: "AWS4-HMAC-SHA256 Credential=ASIATWINREAD/x" }, change = { authorization: "AWS4-HMAC-SHA256 Credential=ASIATWINCHANGE/x" };
+const form = (o) => new URLSearchParams(o).toString();
+const post = (url, body, h) => T.handle(url, { method: "POST", headers: Object.assign({ "content-type": "application/x-www-form-urlencoded" }, h || {}), body });
+const trailHost = "https://" + T.buckets.trail + ".s3.eu-west-2.amazonaws.com/";
+const list = async (prefix) => { const x = await (await T.handle(trailHost + "?list-type=2&prefix=" + encodeURIComponent(prefix), { method: "GET", headers: read })).text(); return [...x.matchAll(/<Key>([^<]*)<\/Key>/g)].map((m) => m[1]); };
+const records = async (key) => { const b = await (await T.handle(trailHost + encodeURI(key), { method: "GET", headers: read })).arrayBuffer();
+  const t = await new Response(new Blob([b]).stream().pipeThrough(new DecompressionStream("gzip"))).text(); return JSON.parse(t).Records; };
+const live = async (region) => { const keys = (await list("AWSLogs/" + A + "/CloudTrail/" + region + "/")).filter((k) => k.includes("_twin-live")); let all = []; for (const k of keys) all = all.concat(await records(k)); return { keys, all }; };
+const FIELDS = ["eventVersion", "userIdentity", "eventTime", "eventSource", "eventName", "awsRegion", "sourceIPAddress", "userAgent", "requestParameters", "responseElements", "requestID", "eventID", "readOnly", "eventType", "managementEvent", "recipientAccountId", "eventCategory"];
+const shape = (r) => { for (const f of FIELDS) if (!(f in r)) fail(r.eventName + " lacks " + f); if (!/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ$/.test(r.eventTime)) fail("eventTime " + r.eventTime); };
+
+T.reset();
+if ((await live("us-east-1")).keys.length) fail("live records before any call");
+
+// sign-in, allowed and refused
+await post("https://sts.amazonaws.com/", form({ Action: "AssumeRoleWithWebIdentity", RoleArn: "arn:aws:iam::" + A + ":role/sws-aws-platform-read", RoleSessionName: "sws-aws-platform", WebIdentityToken: "x" }));
+await post("https://sts.amazonaws.com/", form({ Action: "AssumeRoleWithWebIdentity", RoleArn: "arn:aws:iam::" + A + ":role/someone-else", RoleSessionName: "sws-aws-platform", WebIdentityToken: "x" }));
+// a trust change
+const trust = { Version: "2012-10-17", Statement: [{ Effect: "Allow", Principal: { Federated: "arn:aws:iam::" + A + ":oidc-provider/token.actions.githubusercontent.com" }, Action: "sts:AssumeRoleWithWebIdentity", Condition: { StringEquals: { "token.actions.githubusercontent.com:aud": "sts.amazonaws.com" } } }] };
+await post("https://iam.amazonaws.com/", form({ Action: "UpdateAssumeRolePolicy", RoleName: "sovereignwebsite-factory-dns", PolicyDocument: JSON.stringify(trust) }), change);
+
+let g = await live("us-east-1");
+if (g.keys.length !== 1) fail("expected one live file for us-east-1, got " + g.keys.length);
+if (!new RegExp("^AWSLogs/" + A + "/CloudTrail/us-east-1/\\d{4}/\\d\\d/\\d\\d/" + A + "_CloudTrail_us-east-1_\\d{8}T\\d{2}[0-5][05]Z_twin-live\\.json\\.gz$").test(g.keys[0])) fail("key " + g.keys[0]);
+if (g.all.map((r) => r.eventName).join() !== "AssumeRoleWithWebIdentity,AssumeRoleWithWebIdentity,UpdateAssumeRolePolicy") fail("us-east-1 events: " + g.all.map((r) => r.eventName));
+g.all.forEach(shape);
+const [ok, denied, upd] = g.all;
+if (ok.userIdentity.type !== "WebIdentityUser" || ok.errorCode) fail("sign-in record");
+if (denied.errorCode !== "AccessDenied") fail("refused sign-in has no errorCode");
+if (upd.readOnly !== false || upd.userIdentity.sessionContext.sessionIssuer.userName !== "sws-aws-platform-change" || upd.requestParameters.roleName !== "sovereignwebsite-factory-dns") fail("trust change record");
+if (new Set(g.all.map((r) => r.eventID)).size !== 3) fail("eventID not unique");
+
+// a stack change through a change set, in the stack's region
+await post("https://cloudformation.eu-west-2.amazonaws.com/", form({ Action: "CreateChangeSet", StackName: "sws-aws-platform", ChangeSetName: "cs-1", TemplateBody: "Resources: {}" }), change);
+await post("https://cloudformation.eu-west-2.amazonaws.com/", form({ Action: "ExecuteChangeSet", StackName: "sws-aws-platform", ChangeSetName: "cs-1" }), change);
+// a CORS change through Cloud Control
+await T.handle("https://cloudcontrolapi.eu-west-2.amazonaws.com/", { method: "POST", headers: Object.assign({ "x-amz-target": "CloudApiService.UpdateResource" }, change),
+  body: JSON.stringify({ TypeName: "AWS::S3::Bucket", Identifier: T.buckets.site, PatchDocument: JSON.stringify([{ op: "add", path: "/CorsConfiguration", value: { CorsRules: [{ Id: "sws-aws-platform", AllowedOrigins: ["http://localhost"] }] } }]) }) });
+g = await live("eu-west-2");
+if (g.all.map((r) => r.eventName).join() !== "CreateChangeSet,ExecuteChangeSet,UpdateResource") fail("eu-west-2 events: " + g.all.map((r) => r.eventName));
+g.all.forEach(shape);
+if (g.all.some((r) => r.awsRegion !== "eu-west-2" || r.readOnly)) fail("eu-west-2 records region or readOnly");
+// reads leave no live record
+await T.handle(trailHost + "?list-type=2", { method: "GET", headers: read });
+if ((await live("eu-west-2")).all.length !== 3) fail("a read added a record");
+// the seeded files are still there
+if (!(await list("AWSLogs/" + A + "/CloudTrail/eu-west-2/2026/11/22/")).some((k) => k.endsWith("_demo.json.gz"))) fail("seeded file gone");
+T.reset();
+if ((await live("us-east-1")).keys.length) fail("reset kept live records");
+console.log("ok cloudtrail-live: sign-in, refused sign-in, trust change, change set, CORS change recorded per region; reads not recorded; reset clears");
